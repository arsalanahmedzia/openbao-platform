{
  "name": "openbao-platform",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash scripts/setup/install-tools.sh",
  "forwardPorts": [443],
  "portsAttributes": {
    "443": {
      "label": "OpenBao UI (HTTPS via ingress)",
      "protocol": "https"
    }
  }
}
