# Never commit private keys or local secrets
*.agekey
age.key
keys.txt
*.pem
.env
*.env

# Unencrypted secret drafts (encrypt to *.sops.yaml before committing)
*.secret.yaml
*.dec.yaml

# OpenBao unseal keys and root token (scripts write it to ~, this is a safety net)
openbao-init.json

# Local tooling
.DS_Store
.idea/
.vscode/
